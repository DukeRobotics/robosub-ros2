{
    "name": "RoboSub ROS2",
    "dockerComposeFile": "${localEnv:ROBOSUB_ROS2_COMPOSE_FILE_PATH:../docker-compose.yml}",
    "service": "robosub-ros2",
    "workspaceFolder": "/home/ubuntu/robosub-ros2",
    "initializeCommand": "bash ./docker-build.sh skip-wsl",
    "runArgs": ["--privileged"],
    // Bind-mount each developer's host Claude Code/Codex config and auth paths into the container.
    // This lets a developer who is already logged in to Claude Code and/or the Codex CLI on their host machine
    // just run `claude`/`codex` in the Dev Container's integrated terminal without logging in again.
    // docker-build.sh creates these paths on the host first if they don't already exist.
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/ubuntu/.claude,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/ubuntu/.claude.json,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/home/ubuntu/.codex,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "bierner.github-markdown-preview",
                "charliermarsh.ruff",
                "cschlosser.doxdocgen",
                "dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "esbenp.prettier-vscode",
                "github.copilot",
                "github.copilot-chat",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "jeff-hykin.better-cpp-syntax",
                "mechatroner.rainbow-csv",
                "ms-azuretools.vscode-docker",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode-remote.vscode-remote-extensionpack",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.vscode-serial-monitor",
                "ms-vsliveshare.vsliveshare",
                "redhat.vscode-yaml",
                "tamasfe.even-better-toml",
                "timonwong.shellcheck",
                "yahyabatulu.vscode-markdown-alert"
            ],
            "settings": {
                // File and editor-related settings
                "files.trimTrailingWhitespace": true,
                "files.eol": "\n",
                "[python]": {
                    "editor.rulers": [
                        120
                    ]
                },
                "[ui]": {
                    "editor.tabSize": 2
                },
                "editor.insertSpaces": true,

                // Git-related settings
                "git.enableCommitSigning": true,

                // Python-related settings
                "python.defaultInterpreterPath": "/home/ubuntu/venv/bin/python3",
                "python.terminal.activateEnvironment": false,

                // TypeScript/JavaScript-related settings
                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.formatOnSave": true
                },
                "[typescriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.formatOnSave": true
                },
                "[javascript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.formatOnSave": true
                },
                "[javascriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.formatOnSave": true
                },
                "eslint.workingDirectories": [
                    "foxglove"
                ],

                // Doxygen doc generator settings
                "doxdocgen.generic.returnTemplate": "@return ",

                // CMake-related settings
                "cmake.ignoreCMakeListsMissing": true,
                "cmake.options.statusBarVisibility": "hidden",
                "cmake.options.advanced": {
                    "build": {
                        "statusBarVisibility": "inherit"
                    },
                    "launch": {
                        "statusBarVisibility": "inherit"
                    },
                    "debug": {
                        "statusBarVisibility": "inherit"
                    }
                },

                // C++-related settings
                "C_Cpp.clang_format_path": "/usr/bin/clang-format"
            }
        }
    }
}